{
  "name": "pockettts",
  "displayName": "Pocket TTS (local CPU)",
  "protocol": "narova-tts-provider/v1",
  "command": [
    "python3",
    "./run.py"
  ],
  "requiredEnvironment": [],
  "capabilities": {
    "synthesis": true,
    "voiceListing": true,
    "languages": true,
    "wordTimings": false,
    "surroundingText": false
  },
  "deliveryCapabilities": {
    "seed-stabilization": "honored",
    "delivery-instruct": "ignored",
    "pronunciation-markup": "ignored",
    "pause-markup": "ignored",
    "emphasis-markup": "ignored",
    "non-latin-script": "ignored"
  }
}
