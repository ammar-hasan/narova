{
  "name": "narova",
  "version": "0.29.0",
  "description": "Deterministic scene-scripted video CLI with local voices, word-synced captions, and local renderers.",
  "type": "commonjs",
  "main": "src/pipeline.js",
  "bin": {
    "narova": "bin/narova.js",
    "narova-setup": "setup.sh",
    "narova-uninstall": "uninstall.sh"
  },
  "scripts": {
    "test": "npm run -s test:js && npm run -s test:py",
    "test:js": "node --test 'test/*.test.js'",
    "test:py": "PYTHONPATH=py python3 -m unittest discover -s py/tests",
    "test:install": "node --test test/install.test.js"
  },
  "files": [
    "bin/",
    "src/",
    "vendor/",
    "install.sh",
    "setup.sh",
    "uninstall.sh",
    "py/*.py",
    "py/*.txt",
    "py/narova_tts/*.py"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@napi-rs/canvas": "1.0.3",
    "fontkit": "2.0.4"
  },
  "license": "MIT"
}
