{
  "name": "narova-repo",
  "version": "0.31.14",
  "description": "Development workspace for the standalone Narova CLI and its separate agent skills.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "narova": "node tool/bin/narova.js",
    "test": "npm run -s test:tool && npm run -s test:integration && npm run -s test:elevenlabs && npm run -s test:openai",
    "test:tool": "npm test --prefix tool",
    "test:js": "npm run test:js --prefix tool",
    "test:py": "npm run test:py --prefix tool",
    "test:install": "npm run test:install --prefix tool",
    "test:integration": "node --test test/*.test.js",
    "test:elevenlabs": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s skills/narova-elevenlabs/tests",
    "test:openai": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s skills/narova-openai/tests",
    "test:stock-live": "npm run test:stock-live --prefix tool",
    "test:package": "node scripts/check-package.js",
    "test:package-install": "node scripts/test-packed-package.js",
    "test:release": "node scripts/check-release.js",
    "gallery:build": "node scripts/build-gallery.js",
    "gallery:check": "node scripts/build-gallery.js --check",
    "release:check": "npm test && npm run -s test:package && npm run -s test:package-install && npm run -s test:release",
    "eval:walkthrough": "node tool/evals/walkthrough-eval.js",
    "eval:no-browser": "node tool/evals/no-browser-complex-eval.js",
    "version:sync": "node scripts/sync-version.js",
    "version": "node scripts/sync-version.js"
  }
}
